{
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm run:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(node:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push origin HEAD)",
      "Bash(git worktree:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh issue:*)"
    ],
    "deny": [
      "Bash(*--no-gpg-sign*)",
      "Bash(git -c commit.gpgsign=false*)",
      "Bash(git config *gpgsign*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin *:main)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler login*)",
      "Bash(*wrangler rollback*)",
      "Bash(*wrangler secret*)",
      "Bash(*wrangler delete*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh repo delete*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(*vp add*)",
      "Bash(*vp remove*)",
      "Bash(*vp update*)",
      "Bash(*vp upgrade*)",
      "Bash(*vp migrate*)",
      "Bash(*vp env pin*)",
      "Bash(*vp env setup*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != true ] || \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh"
          }
        ]
      }
    ]
  }
}
