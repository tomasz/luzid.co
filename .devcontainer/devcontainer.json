{
  "name": "luzid.co",
  "build": { "dockerfile": "Dockerfile" },
  "features": { "ghcr.io/devcontainers/features/github-cli:1": {} },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vp/.agents/claude",
    "CODEX_HOME": "/home/vp/.agents/codex",
    "CURSOR_CONFIG_DIR": "/home/vp/.agents/cursor",
    "GH_CONFIG_DIR": "/home/vp/.agents/gh",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "mounts": [
    "source=luzid-agents,target=/home/vp/.agents,type=volume",
    "source=/run/host-services/ssh-auth.sock,target=/ssh-agent,type=bind"
  ],
  "postCreateCommand": "vp install --frozen-lockfile && pnpm exec playwright install --with-deps",
  "postStartCommand": "mkdir -p ~/.config/git && keys=$(ssh-add -L) && echo \"$keys\" | sed 's/^/* /' > ~/.config/git/allowed_signers"
}
